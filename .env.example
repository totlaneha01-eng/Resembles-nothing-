# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/resembles_nothing"

# --- Auth ---
JWT_SECRET="generate with: openssl rand -base64 48"

# --- Bank detail encryption (artist payouts) ---
BANK_ENCRYPTION_KEY="generate with: openssl rand -base64 32"

# --- Razorpay (https://dashboard.razorpay.com/app/keys) ---
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="set this in Razorpay Dashboard > Webhooks"

# --- WhatsApp Business Cloud API (https://business.facebook.com) ---
WHATSAPP_PHONE_NUMBER_ID="xxxxxxxxxxxxxxx"
WHATSAPP_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_VERIFY_TOKEN="pick any string, enter the same one in Meta's webhook setup"

# --- Google Calendar (gift reminders) — console.cloud.google.com ---
# See src/lib/googleCalendar.js's doc comment for the exact setup steps
# (new project -> enable Calendar API -> OAuth consent screen -> Web
# application credentials -> redirect URI <your domain>/api/calendar/callback).
# Both free — no billing account needed for the Calendar API. Leave unset and
# the whole feature (routes + the daily sync job) quietly stays off.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Misc ---
# The user id (from your User table, once seeded/created) that should receive
# "chat with the artist" notifications for house designs that have no artist.
STUDIO_ADMIN_USER_ID=""

PORT=4000
NODE_ENV=development
