# --- Database ---
# On Supabase: DATABASE_URL is the pooled connection (PgBouncer, port 6543).
# DIRECT_URL is the unpooled connection (port 5432) — `prisma migrate
# deploy` needs it specifically, since PgBouncer's transaction-mode pooling
# doesn't support the session-level locks migrations take. Get both fresh
# from the Supabase dashboard (Settings -> Database -> Connection string),
# not from an old copy — a stale/wrong value here is what caused a real
# production outage earlier (see prisma/schema.prisma's datasource comment).
# Running this app as a long-lived process (Docker/systemd, not serverless)
# means you could point both at the direct connection if you'd rather not
# deal with the pooler at all — same pattern Render used.
DATABASE_URL="postgresql://user:password@localhost:5432/resembles_nothing"
DIRECT_URL="postgresql://user:password@localhost:5432/resembles_nothing"

# --- Auth ---
JWT_SECRET="generate with: openssl rand -base64 48"

# --- Admin bootstrap ---
# Comma-separated list of account emails to promote to admin on boot —
# matched case-insensitively. Leave unset if you're promoting admins by
# hand instead (node scripts/make-admin.js <email>).
ADMIN_BOOTSTRAP_EMAIL=""

# --- Transactional email (forgot-password) — resend.com ---
# Sign up, verify a sending domain (or use their shared test domain while
# developing), create an API key. RESEND_FROM_EMAIL must be an address on a
# domain you've verified with Resend. Leave both unset and forgot-password
# still works end-to-end in dev — the reset link is just logged to the
# server console instead of emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# --- Bank detail encryption (artist payouts) ---
BANK_ENCRYPTION_KEY="generate with: openssl rand -base64 32"

# --- WhatsApp Business Cloud API (https://business.facebook.com) ---
WHATSAPP_PHONE_NUMBER_ID="xxxxxxxxxxxxxxx"
WHATSAPP_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_VERIFY_TOKEN="pick any string, enter the same one in Meta's webhook setup"

# --- Google Calendar (gift reminders) — console.cloud.google.com ---
# See src/lib/googleCalendar.js's doc comment for the exact setup steps
# (new project -> enable Calendar API -> OAuth consent screen -> Web
# application credentials -> redirect URI <your domain>/api/calendar/callback).
# Both free — no billing account needed for the Calendar API. Leave unset and
# the whole feature (routes + the daily sync job) quietly stays off.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Misc ---
# The user id (from your User table, once seeded/created) that should receive
# "chat with the artist" notifications for house designs that have no artist.
STUDIO_ADMIN_USER_ID=""

PORT=4000
NODE_ENV=development
