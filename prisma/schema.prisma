// resembles.nothing — database schema
// Run `npx prisma migrate dev` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Users ----------

model User {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  passwordHash   String
  isArtist       Boolean  @default(false)
  isAdmin        Boolean  @default(false)
  whatsappNumber String?
  whatsappOptIn  Boolean  @default(false)
  createdAt      DateTime @default(now())

  bankDetails BankDetails?
  submissions ArtistSubmission[]
  products    Product[]          @relation("ArtistProducts")
  cartItems   CartItem[]
  savedProducts SavedProduct[]
  designRequests DesignRequest[]
  orders      Order[]
  reviews     Review[]
  quizResult  QuizResult?
  notifications NotificationLog[]
  payoutsOwed OrderItem[]        @relation("ArtistPayouts")
  chatsAsCustomer ChatMessage[]  @relation("CustomerChats")
  chatsSent       ChatMessage[]  @relation("SentChats")
  calendarConnection CalendarConnection?
}

// Bank details are collected so we can pay artists per sale.
// accountNumberEnc must be encrypted at rest (see src/lib/crypto.js) — never store plaintext.
model BankDetails {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  accountHolderName String
  accountNumberEnc  String
  ifsc              String
  upiId             String?
  updatedAt         DateTime @updatedAt
}

// ---------- Catalog ----------

enum ProductFormat {
  TAPESTRY
  CANVAS
  DIPTYCH // split canvas, 2 panels
  TRIPTYCH // split canvas, 3 panels
  QUADRIPTYCH // split canvas, 4 panels
}

enum ProductStatus {
  ACTIVE
  SOLD
  RETIRED
}

model Product {
  id          String        @id @default(uuid())
  slug        String        @unique
  name        String
  category    String
  price       Int // in paise (₹1 = 100) — a reference/"from" price; the real per-order price comes from src/lib/pricing.js's format+size tiers
  widthCm     Int
  images      String[] // [far, close, exact] — matches the 3-image gallery in the frontend
  blurb       String
  description String        @db.Text
  story       String        @db.Text
  features    String[]
  formats     ProductFormat[] // which formats this design can be ordered in — e.g. a design might be offered as both Tapestry and Canvas
  editionSize Int             @default(1) // total pieces sellable across ALL formats/sizes combined — 1 = true one-of-one, set higher for a limited run
  unitsSold   Int             @default(0) // status flips to SOLD once this reaches editionSize (not wired to checkout yet — see src/routes/orders.js)
  status      ProductStatus   @default(ACTIVE)
  cartCount   Int             @default(0) // denormalized counter shown as social proof; recomputed by a cron, see src/lib/cartCount.js
  soldAt      DateTime?

  artistId String? // null = house design, made by the resembles.nothing studio
  artist   User?   @relation("ArtistProducts", fields: [artistId], references: [id])

  submission   ArtistSubmission? @relation(fields: [submissionId], references: [id])
  submissionId String?           @unique

  cartItems  CartItem[]
  savedBy    SavedProduct[]
  orderItems OrderItem[]
  reviews    Review[]
  chatMessages ChatMessage[]

  createdAt DateTime @default(now())

  @@index([category])
  @@index([status])
}

// ---------- Artist submissions (review queue) ----------

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model ArtistSubmission {
  id             String           @id @default(uuid())
  artistId       String
  artist         User             @relation(fields: [artistId], references: [id])
  title          String
  description    String           @db.Text
  formats        ProductFormat[]
  editionSize    Int              @default(1) // how many total pieces the artist wants to make of this design
  suggestedPrice Int
  imageUrl       String
  status         SubmissionStatus @default(PENDING)
  reviewNote     String? // shown to the artist if rejected
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())

  product Product?
}

// ---------- Cart & Orders ----------
// Every cart/order line is tied to a specific format + size tier — not just a
// product — since a design can be offered in more than one format (see
// Product.formats), and within a format the frontend lets buyers pick
// Signature/Grand/Monument (tapestry), Window/Gateway/Portal/Realm (canvas),
// etc., each at its own INR and USD price. See src/lib/pricing.js for the
// tier tables these prices come from.

model CartItem {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  productId String
  product   Product       @relation(fields: [productId], references: [id])
  format    ProductFormat // which of the design's available formats was picked
  sizeLabel String // "Signature" | "Grand" | "Monument" | "Window" | "Gateway" | "Portal" | "Realm"
  sizeDims  String // "70 × 100 cm"
  priceINR  Int // the actual amount charged, in INR — this is what Razorpay bills
  priceUSD  Int // shown for reference only when the shopper has USD display mode on
  qty       Int           @default(1)
  createdAt DateTime      @default(now())

  @@unique([userId, productId, format, sizeLabel])
}

// The "Saved" / wishlist heart on a product card — unlike CartItem, this
// isn't tied to a format or size, just "I like this design."
model SavedProduct {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// "Stay in the loop" footer email capture — deliberately not tied to User,
// since most visitors signing up here haven't made an account yet.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// "Request a custom design" — a free-text idea from a shopper, reviewed by
// hand (no automated quoting/production pipeline). userId is optional since
// a visitor can submit one before creating an account, in which case name/
// contact carry how to reach them back.
// A paid custom-design commission: the customer describes what they want and
// pays a flat fee (feeINR/feeUSD, snapshotted per-request so a later price
// change doesn't rewrite history) via the same manual-UPI flow orders use.
// Once paid, an admin works up a handful of directions (iterationImages) and
// the customer picks a favourite over WhatsApp/email; when it's finished, an
// admin lists it as a normal Product so they can buy it in whatever
// format/size they want — same checkout as everything else. Nothing here
// tracks that final purchase; it's just the commission stage.
model DesignRequest {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String?
  contact   String? // email, phone, or WhatsApp — however they want to be reached
  message   String   @db.Text

  feeINR             Int       @default(499) // paise would match Product.price's convention, but this is a flat quote shown as a whole rupee amount, not a per-unit price — keeping it a plain rupee figure avoids a confusing /100 at every call site for the one field that needs it
  feeUSD             Float     @default(4.99)
  paymentMethod      String    @default("UPI_MANUAL")
  paymentConfirmed   Boolean   @default(false)
  paymentConfirmedAt DateTime?
  paymentScreenshot  String?   @db.Text // same as Order.paymentScreenshot — see that field's comment

  iterationImages String[] @default([]) // URLs an admin pastes in once the first round of directions is ready
  iterationNote   String?  @db.Text // a short message to go with them, e.g. "here are 5 directions — reply with your favourite"

  status    String   @default("NEW") // NEW | IN_PROGRESS | ITERATIONS_SENT | DONE — plain string, not worth an enum at this size
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PLACED
  BEING_MADE
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  items             OrderItem[]
  totalAmount       Int
  status            OrderStatus @default(PLACED)
  razorpayOrderId   String?     @unique
  razorpayPaymentId String?
  shippingAddress   Json
  createdAt         DateTime    @default(now())

  // Set by an admin from the Admin Dashboard once they've matched the
  // buyer's UPI payment screenshot to this order — see the "Confirm
  // Payment" flow in routes/orders.js. Only meaningful for orders placed
  // through the manual-UPI checkout (paymentMethod: "UPI_MANUAL");
  // Razorpay orders are considered paid once /verify succeeds instead.
  paymentMethod      String    @default("RAZORPAY") // "RAZORPAY" | "UPI_MANUAL"
  paymentConfirmed   Boolean   @default(false)
  paymentConfirmedAt DateTime?

  // The buyer's UPI payment screenshot, uploaded straight from checkout —
  // a base64 data URI, stored here (not on disk: Render's filesystem isn't
  // persistent across deploys) so it survives as long as the order does and
  // an admin can review it right next to "Confirm Payment" instead of
  // having to go dig through WhatsApp. Temporary, same as the whole
  // manual-UPI flow — goes away once Razorpay verification replaces it.
  paymentScreenshot String? @db.Text

  statusEvents OrderStatusEvent[]
}

// Every status change is logged here, and each one is what triggers a WhatsApp
// message via src/lib/whatsapp.js — this is the "every step of the journey" feature.
model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

enum PayoutStatus {
  NOT_APPLICABLE // house design, no artist to pay
  PENDING
  PAID
}

model OrderItem {
  id                 String       @id @default(uuid())
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id])
  productId          String
  product             Product     @relation(fields: [productId], references: [id])
  format             ProductFormat
  sizeLabel          String
  sizeDims           String
  priceINR           Int // actual amount charged for this line, in INR
  priceUSD           Int // reference value only — never charged
  artistId           String?
  artist             User?        @relation("ArtistPayouts", fields: [artistId], references: [id])
  artistPayoutAmount Int?
  artistPayoutStatus PayoutStatus @default(NOT_APPLICABLE)
  artistPayoutPaidAt DateTime?
}

// ---------- Reviews & customer photos ----------

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  rating    Int
  text      String
  photoUrls String[]
  createdAt DateTime @default(now())
}

// ---------- Art persona quiz ----------

model QuizResult {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  personaId   String
  personaName String
  createdAt   DateTime @default(now())
}

// ---------- Notifications (WhatsApp + in-app) ----------

model NotificationLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  channel   String // "whatsapp" | "app"
  title     String
  body      String
  status    String // "sent" | "failed" | "queued"
  createdAt DateTime @default(now())
}

// ---------- Gift reminders (Google Calendar) ----------
// One connection per user — "Connect Calendar" on the account page. Only a
// refresh token is kept; access tokens are minted on demand via
// src/lib/googleCalendar.js and never persisted. refreshTokenEnc reuses the
// same AES-256-GCM helper (src/lib/crypto.js) and BANK_ENCRYPTION_KEY as
// BankDetails.accountNumberEnc, rather than adding a second encryption key
// for what's the same kind of thing: a small third-party secret at rest.

model CalendarConnection {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id])
  refreshTokenEnc String
  scope           String
  connectedAt     DateTime  @default(now())
  lastSyncedAt    DateTime?
}

// ---------- Chat with the Artist ----------
// One conversation per (product, customer) pair — matches the frontend's
// per-product chat modal. Either the customer or the artist can send into it.

model ChatMessage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  customerId String
  customer   User     @relation("CustomerChats", fields: [customerId], references: [id])
  senderId   String
  sender     User     @relation("SentChats", fields: [senderId], references: [id])
  text       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([productId, customerId])
}
